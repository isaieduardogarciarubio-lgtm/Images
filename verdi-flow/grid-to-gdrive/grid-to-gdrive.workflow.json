        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"skill_version\": $json.skill_version, \"download_doc_id\": $json.doc_id } }}",
        "options": {}
      },
      "id": "246e6929-7155-44fb-8d9f-c7d8a91d053c",
